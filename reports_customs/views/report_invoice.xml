<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="arabic_english_invoice" inherit_id="l10n_gcc_invoice.arabic_english_invoice">

                <xpath expr="//div[@id='informations']" position="replace">
                 <link rel="stylesheet" href="/reports_customs/static/src/css/style.css"/>
                  <link rel="stylesheet" href="/reports_customs/static/src/css/font.css"/>
                <div>
                 <div class="row p-1 mt-1  bg-light">
		        <div class="col-6">
		            <Strong>Customer Information</Strong>
		        </div>
		        <div style="text-align:right" class="col-6 text-right">
		            <Strong>معلومات العميل</Strong>
		        </div>
                </div>
             <div class="px-2">
                <div class="row">
                    <div class="col-3">
                        <Strong>Name</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.name"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>الاسم</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>Building No</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.l10n_sa_edi_building_number"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>رقم المبني</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>Street</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.street"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>اسم الشارع</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>District</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.street2"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>الحي</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>City</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.city"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>المدينة</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>Country</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.country_id.name"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>البلد</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>Postal Code</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.zip"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>الرمز البريدي</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>Additional No</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.l10n_sa_edi_plot_identification"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>الرقم الاضافي للعنوان</Strong>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <Strong>Vat Number</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.partner_id.vat"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>رقم تسجيل ضريبة القيمة المضافة</Strong>
                    </div>

                </div>
                </div>
                 <div class="row">
                    <div class="col-3">
                        <Strong>P.O Refrence</Strong>
                    </div>
                    <div class="col-5 text-center">
                        <span t-field="o.payment_reference"></span>
                    </div>
                    <div style="text-align:right" class="col-4 text-right">
                        <Strong>رقم امر الشراء</Strong>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
            <div class="oe_structure"/>
            
            <div class="row p-1 mt-3 bg-light">
                <div class="col-6">
                    <Strong>Invoice Lines</Strong>
                </div>
                <div style="text-align:right" class="col-6 text-right">
                    <Strong>الاصناف</Strong>
                </div>
            </div>
                
 </xpath>
        
        <xpath expr="//t[@t-set='address']" position="replace">
            <t >
                <div class="row my-1">
                <div class="col-9">
                    <div class="row">
                        <div class="col-4">
                            <Strong>Invoice Number</Strong>
                        </div>
                        <div style="text-align:center" class="col-4">
                            <span t-field="o.name"></span>
                        </div>
                        <div style="text-align:center" class="col-4 text-right">
                            <Strong>رقم الفاتورة</Strong>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <Strong>Invoice Date</Strong>
                        </div>
                        <div style="text-align:center" class="col-4">
                            <span t-field="o.invoice_date"></span>
                        </div>
                        <div style="text-align:center" class="col-4 text-right">
                            <Strong>تاريخ الفاتورة</Strong>
                        </div>
                    </div>

                </div>
                     <div class="col-3" >
                    <img t-if="o.l10n_sa_qr_code_str"
                         style="display:block;float:right"
                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(o.l10n_sa_qr_code_str), 130, 130)"/>
                    </div>
                    
                   
           
                 
                    <!--                    <div class="row">-->
                    <!--                        <div class="col-4">-->
                    <!--                            <Strong>Date of Supply</Strong>-->
                    <!--                        </div>-->
                    <!--                        <div class="col-4 text-center">-->
                    <!--                            <span t-field="doc.einv_sa_delivery_date"></span>-->
                    <!--                        </div>-->
                    <!--                        <div class="col-4 text-right">-->
                    <!--                            <Strong>تاريخ التوريد</Strong>-->
                    <!--                        </div>-->
                    <!--                    </div>-->
                    
                       
                
               
            </div>
            </t>
        </xpath>
                    <xpath expr="//div[hasclass('clearfix')]" position="replace">

<div style="page-break-inside: avoid;">
                <div class="row p-1 mt-1 bg-light">
                    <div class="col-6">
                        <Strong>Total Amount:</Strong>
                    </div>
                    <div class="col-6" style="text-align: right;">
                        <Strong>:الاجمالي</Strong>
                    </div>
                </div>
                <div class="row">
                    <!--                    <div class="col-2"></div>-->
                    <div class="col-12">
                        <div class="row border border-top-0">
                            <div class="col-4">Total (Excluding VAT)</div>
                            <div class="col-6 text-right">الاجمالي غير شامل ضريبة القيمة المضافة</div>
                            <div class="col-2 text-center">
                                <span t-field="o.amount_untaxed"></span>
                            </div>
                        </div>
                       
                        <div class="row border border-top-0">
                            <div class="col-4">Total Taxable Amount (Excluding VAT)</div>
                            <div class="col-6 text-right">الإجمالي الخاضع للضريبة غير شامل ضريبة القيمة
                                المضافة
                            </div>
                            <div class="col-2 text-center">
                                <span t-field="o.amount_untaxed"></span>
                            </div>
                        </div>
                        <div class="row border border-top-0">
                            <div class="col-4">Total VAT</div>
                            <div class="col-6 text-right">إجمالي الضريبة المضافة</div>
                            <div class="col-2 text-center">
                                <span t-field="o.amount_tax_signed"></span>
                            </div>
                        </div>
                        <div class="row border border-top-0">
                            <div class="col-4">Total Amount Due</div>
                            <div class="col-6 text-right">الإجمالي المستحق</div>
                            <div class="col-2 text-center">
                                <span t-field="o.amount_total"></span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
</xpath>
          
                                  <xpath expr="//span[@t-field='o.payment_reference']/../.." position="replace"/>  
                                            
    </template>

</odoo>
